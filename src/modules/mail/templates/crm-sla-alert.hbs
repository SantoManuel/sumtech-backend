<!DOCTYPE html>
<html lang="es">
<head><meta charset="utf-8" /></head>
<body style="margin:0;padding:0;background-color:#f1f5f9;font-family:Arial,Helvetica,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f1f5f9;padding:24px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="background-color:#ffffff;border-radius:16px;overflow:hidden;">
          <tr>
            <td style="background-color:#080808;padding:20px 28px;">
              <span style="color:#2FCB09;font-weight:800;font-size:16px;">SUMTECH</span>
              <span style="color:#94a3b8;font-size:12px;"> · Alerta de SLA</span>
            </td>
          </tr>
          <tr>
            <td style="padding:28px;">
              <h1 style="margin:0 0 8px;font-size:18px;color:#e11d48;">{{count}} oportunidad(es) sin actividad excediendo el SLA</h1>
              <p style="margin:0 0 20px;font-size:13px;color:#475569;">Hola {{agentName}}, estas oportunidades llevan más días sin actividad de los permitidos para su etapa.</p>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                {{#each opportunities}}
                <tr>
                  <td style="padding:10px 0;border-bottom:1px solid #e2e8f0;">
                    <p style="margin:0;font-size:13px;font-weight:700;color:#0f172a;">{{this.name}}</p>
                    <p style="margin:2px 0 0;font-size:12px;color:#e11d48;">{{this.statusName}} — {{this.daysSinceUpdate}} días sin actividad (máximo permitido: {{this.maxDays}})</p>
                  </td>
                </tr>
                {{/each}}
              </table>
              <p style="margin:24px 0 0;font-size:11px;color:#94a3b8;">Entra al CRM para retomar el seguimiento: {{crmUrl}}</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
