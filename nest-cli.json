{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      "modules/mail/templates/**/*",
      "modules/invoicing/dgii/schemas/**/*",
      "database/migrations/**/*",
      "database/platform-migrations/**/*"
    ],
    "watchAssets": true
  }
}
