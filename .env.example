# ==============================================================================
# SUMTECH ERP - BACKEND ENVIRONMENT CONFIGURATION (EJEMPLO)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR / APLICACIÓN NESTJS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS (PostgreSQL 3NF con Multi-Esquema)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=sumtech_erp
# En producción SIEMPRE debe ser false para usar migraciones controladas
DB_SYNCHRONIZE=false
DB_LOGGING=true

# ------------------------------------------------------------------------------
# 2.1. BASE DE DATOS DE PLATAFORMA (SaaS — tenants, planes, SuperAdmin)
# ------------------------------------------------------------------------------
# Mismo servidor Postgres que DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD de arriba,
# solo cambia el nombre de la base. Ver Fase 0 del plan multi-tenant — NUNCA
# debe contener datos de ningún tenant, solo el registro de tenants/planes/
# suscripciones/usuarios SuperAdmin.
PLATFORM_DB_DATABASE=sumtech_platform
# Credenciales con privilegio CREATEDB, usadas SOLO por TenantProvisioningService
# (Fase 3) para crear/eliminar la base de datos de un tenant nuevo al
# aprovisionar/limpiar. En local, el mismo superusuario de DB_USERNAME/
# DB_PASSWORD ya sirve — en producción usar un rol dedicado con el mínimo
# privilegio necesario (CREATEDB, sin acceso de lectura a las DBs de tenants).
DB_ADMIN_USERNAME=postgres
DB_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 3. SEGURIDAD Y TOKENS JWT
# ------------------------------------------------------------------------------
JWT_SECRET=clave_secreta_jwt_para_firmar_access_tokens_sumtech_2026
JWT_EXPIRATION_TIME=15m
JWT_REFRESH_SECRET=clave_secreta_para_firmar_refresh_tokens_sumtech_2026
JWT_REFRESH_EXPIRATION_TIME=7d
# JWT de la plataforma SaaS (SuperAdmin/Support) — DEBE ser distinto de
# JWT_SECRET/JWT_REFRESH_SECRET: un token de plataforma nunca debe ser válido
# como token de tenant, ni viceversa (ver PlatformAuthGuard).
PLATFORM_JWT_SECRET=clave_secreta_jwt_plataforma_saas_sumtech_2026
PLATFORM_JWT_EXPIRATION_TIME=8h

# ------------------------------------------------------------------------------
# 4. REDIS (Caché, Carritos de Compra POS y Lista Negra de Tokens)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CART_TTL_SECONDS=7200

# ------------------------------------------------------------------------------
# 5. FACTURACIÓN ELECTRÓNICA DGII (República Dominicana - e-CF)
# ------------------------------------------------------------------------------
# Ambiente: 'sandbox' simula todo localmente (no llama a la DGII); 'testecf' /
# 'certecf' / 'ecf' sí llaman a los servidores reales de la DGII (homologación,
# certificación y producción respectivamente).
DGII_ENVIRONMENT=sandbox
DGII_RNC_EMISOR=131000000
DGII_CERT_PATH=./certs/tu_certificado.p12
DGII_CERT_PASSWORD=password_certificado_digital
# Única URL base reutilizada por dgii-client.service.ts para autenticación,
# recepción y consulta (llamadas relativas) — sin sufijo de path.
DGII_AUTH_URL=https://ecf.dgii.gov.do/testecf/

# Clave de cifrado en reposo (AES-256-GCM) para secretos de tenant guardados en
# sec.company_profile (ej. dgii_cert_password) — ver
# src/common/utils/secret-crypto.util.ts. Generar con: openssl rand -base64 32
COMPANY_SECRETS_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 6. CONFIGURACIÓN DE CORREO / NOTIFICACIONES (Opcional)
# ------------------------------------------------------------------------------
# Usado por MailModule/MailService (modules/mail) — recordatorios de próxima
# acción, alertas de SLA y encuesta de satisfacción del CRM, reutilizable por
# cualquier otro módulo que necesite enviar correo. Sin SMTP_HOST configurado,
# el envío se omite de forma controlada (se loguea, no rompe el flujo).
#
# Para usar Gmail como remitente: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=tu_correo@gmail.com. SMTP_PASS NO es tu contraseña de Gmail: activa
# la verificación en 2 pasos en myaccount.google.com/security, entra a
# "Contraseñas de aplicaciones" y genera una específica de 16 caracteres.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=contraseña_de_aplicacion_16_caracteres
SMTP_FROM="Sumtech Telecomunicaciones <tu_correo@gmail.com>"

# ------------------------------------------------------------------------------
# 7. CHATBOT IA (proyecto separado Chatbot_sumtech — SaaS multi-tenant, RAG + Gemini/Ollama)
# ------------------------------------------------------------------------------
# Usado por PortalService.processChatMessage() y PublicChatService.sendMessage()
# para responder el chat de /portal/soporte y del widget del landing con IA real
# (en vez del sistema de keywords, que queda como fallback si el servicio no
# responde). CHATBOT_API_KEY es la key maestra de administración — solo para
# /whatsapp/send y /admin/* — debe coincidir con PORTAL_PROXY_API_KEY del .env
# de Chatbot_sumtech. CHATBOT_TENANT_API_KEY es la TenantApiKey tipo SECRET del
# tenant "sumtech" (se emite desde el panel de administración de Chatbot_sumtech
# o su tabla tenant_api_keys) — es la que autentica /chat/widget/message.
# CHATBOT_TENANT_ID es el id de ese mismo tenant, para que el CRM pueda
# reconstruir el externalId prefijado al consultar conversaciones.
# CHATBOT_TIMEOUT_MS es el timeout del axios que llama a /chat/widget/message
# (default 150000 = 2.5min si se omite). Sumtech usa un proveedor LOCAL
# (Ollama, sin GPU dedicada) en Chatbot_sumtech, con latencias medidas de
# hasta ~31s por consulta — debe quedar siempre por encima del timeout interno
# de Chatbot_sumtech hacia Ollama (AiProviderProfile.config.timeoutMs, hoy
# 120000) para no cortar una respuesta que sí iba a completarse.
CHATBOT_URL=http://localhost:4001/api/v1
CHATBOT_API_KEY=changeme_portal_proxy_api_key
CHATBOT_TENANT_API_KEY=changeme_sumtech_tenant_secret_key
CHATBOT_TENANT_ID=changeme_sumtech_tenant_id
CHATBOT_TIMEOUT_MS=150000

# ------------------------------------------------------------------------------
# 8. ROUTEROS (Fase 05 del plan de integración de red — modo sombra)
# ------------------------------------------------------------------------------
# Credenciales de la API REST de cada nodo Mikrotik piloto. A propósito NUNCA
# viven en la base de datos (ver riesgo "Credenciales de RouterOS" del plan):
# JSON indexado por el nombre EXACTO del nodo en /dashboard/red > Nodos.
# Usar un usuario de API con permiso mínimo (grupo "read" o "ppp" solamente,
# nunca "full"). Ejemplo:
# ROUTEROS_CREDENTIALS={"RB Las Yayas":{"username":"api-readonly","password":"cambia_esto"}}
ROUTEROS_CREDENTIALS={}

# ------------------------------------------------------------------------------
# 8b. WIREGUARD HUB CENTRAL (Fase A del plan de producción WireGuard —
#     ver Plan_WireGuard_Produccion.md)
# ------------------------------------------------------------------------------
# Servidor WireGuard central de Sumtech al que se conectan todos los MikroTik
# por túnel. REQUERIDAS para generar el script .rsc — sin ellas,
# GET /network/nodes/:id/wireguard-script responde 400 en vez de generar un
# script con datos de relleno. La clave pública debe ser Base64 válido de
# exactamente 44 caracteres (output de `wg genkey | wg pubkey`).
WIREGUARD_SERVER_ENDPOINT=vpn.tu-dominio.com
WIREGUARD_SERVER_PUBLIC_KEY=

# Fase B (opcional): agente sumtech-wg-agent (repo aparte) que automatiza el
# registro del peer en el hub — sin esto, el flujo sigue funcionando con el
# comando manual que entrega la Fase A (ver NodeFormModal > "Generar y
# Descargar Script"). WIREGUARD_AGENT_TOKEN debe coincidir con el AGENT_TOKEN
# del .env del agente.
WIREGUARD_AGENT_URL=
WIREGUARD_AGENT_TOKEN=

# ------------------------------------------------------------------------------
# 9. GENIEACS (proyecto separado sumtech_servidor_genieacs — gestión de ONU/CPE)
# ------------------------------------------------------------------------------
# Nunca apuntar directo al puerto 7557 de la NBI — siempre a través del nginx
# del propio servidor GenieACS, que valida la API Key y termina TLS (ver
# Fase 00 de la integración: docs/05_erp_integration_plan.md en ese repo).
# Si se deja sin configurar, el módulo genieacs del ERP sigue funcionando
# (no tumba el arranque) pero cualquier acción sobre una ONU falla con un
# mensaje claro en vez de intentar contactar un servidor inexistente.
GENIEACS_NBI_BASE_URL=https://localhost
GENIEACS_NBI_API_KEY=sumtech-nbi-sec-key-9f8a7b6c5d4e3f2a1b0c
