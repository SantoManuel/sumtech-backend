# ==============================================================================
# SUMTECH ERP - BACKEND ENVIRONMENT CONFIGURATION (EJEMPLO)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR / APLICACIÓN NESTJS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS (PostgreSQL 3NF con Multi-Esquema)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=sumtech_erp
# En producción SIEMPRE debe ser false para usar migraciones controladas
DB_SYNCHRONIZE=false
DB_LOGGING=true

# ------------------------------------------------------------------------------
# 3. SEGURIDAD Y TOKENS JWT
# ------------------------------------------------------------------------------
JWT_SECRET=clave_secreta_jwt_para_firmar_access_tokens_sumtech_2026
JWT_EXPIRATION_TIME=15m
JWT_REFRESH_SECRET=clave_secreta_para_firmar_refresh_tokens_sumtech_2026
JWT_REFRESH_EXPIRATION_TIME=7d

# ------------------------------------------------------------------------------
# 4. REDIS (Caché, Carritos de Compra POS y Lista Negra de Tokens)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CART_TTL_SECONDS=7200

# ------------------------------------------------------------------------------
# 5. FACTURACIÓN ELECTRÓNICA DGII (República Dominicana - e-CF)
# ------------------------------------------------------------------------------
# Ambiente: 'sandbox' para pruebas de certificación, 'production' para emisión real
DGII_ENVIRONMENT=sandbox
DGII_RNC_EMISOR=131000000
DGII_CERT_PATH=./certs/sumtech_cert.p12
DGII_CERT_PASSWORD=password_certificado_digital
DGII_AUTH_URL=https://ecf.dgii.gov.do/testecf/autenticacion/
DGII_RECEPTION_URL=https://ecf.dgii.gov.do/testecf/recepcion/
DGII_QUERY_URL=https://ecf.dgii.gov.do/testecf/consultastatus/

# ------------------------------------------------------------------------------
# 6. CONFIGURACIÓN DE CORREO / NOTIFICACIONES (Opcional)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@sumtech.do
SMTP_PASS=password_smtp
SMTP_FROM="Sumtech Telecomunicaciones <notificaciones@sumtech.do>"

# ------------------------------------------------------------------------------
# 7. CHATBOT IA (proyecto separado Chatbot_sumtech — RAG + Gemini/Ollama)
# ------------------------------------------------------------------------------
# Usado por PortalService.processChatMessage() para responder el chat de
# /portal/soporte con IA real en vez del sistema de keywords (que queda como
# fallback si este servicio no responde). Debe coincidir con PORTAL_PROXY_API_KEY
# del .env de Chatbot_sumtech.
CHATBOT_URL=http://localhost:4001/api/v1
CHATBOT_API_KEY=changeme_portal_proxy_api_key

# ------------------------------------------------------------------------------
# 8. GENIEACS (proyecto separado sumtech_servidor_genieacs — gestión de ONU/CPE)
# ------------------------------------------------------------------------------
# Nunca apuntar directo al puerto 7557 de la NBI — siempre a través del nginx
# del propio servidor GenieACS, que valida la API Key y termina TLS (ver
# Fase 00 de la integración: docs/05_erp_integration_plan.md en ese repo).
# Si se deja sin configurar, el módulo genieacs del ERP sigue funcionando
# (no tumba el arranque) pero cualquier acción sobre una ONU falla con un
# mensaje claro en vez de intentar contactar un servidor inexistente.
GENIEACS_NBI_BASE_URL=https://localhost
GENIEACS_NBI_API_KEY=sumtech-nbi-sec-key-9f8a7b6c5d4e3f2a1b0c
